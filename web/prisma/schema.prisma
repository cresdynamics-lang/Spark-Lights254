generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  shortName   String?
  subtitle    String
  description String
  mosaicLabel String?
  image       String
  featured    Boolean   @default(false)
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  type        String
  price       Int
  image       String
  hoverImage  String?
  badge       String?
  styles      String[]
  rooms       String[]
  categories  String[] @default([])
  finish      String[]
  sizes       String[]
  description String
  specs       Json
  signature   Boolean  @default(false)
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([published])
  @@index([categories])
}

model Room {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  headline    String
  description String
  image       String
  tips        Json
  faqs        Json
  chooseBy    Json?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Location {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  blurb     String
  homes     String
  delivery  String
  window    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guide {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  summary   String
  intent    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  area      String
  room      String
  image     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  topic        String
  excerpt      String
  body         String   @db.Text
  author       String   @default("Sparklights 254")
  minutes      Int      @default(5)
  featured     Boolean  @default(false)
  published    Boolean  @default(true)
  audienceHref String?
  image        String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published])
  @@index([topic])
}

model SeoPage {
  id           String   @id @default(cuid())
  path         String   @unique
  title        String
  description  String
  h1           String
  canonical    String
  family       String
  schemaType   String
  parentPath   String?
  indexable    Boolean  @default(true)
  published    Boolean  @default(true)
  phase        Int?
  audienceHref String?
  lastModified DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, indexable])
  @@index([family])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
